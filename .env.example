# Copy this file to .env.local and adjust the values.
# .env.local is git-ignored and must never be committed.

# Connection string for the local (or remote) MongoDB instance used as
# the read-only cache/sync store for your Zotero library.
# Default matches the docker-compose.yml service in this repo.
MONGODB_URI=mongodb://127.0.0.1:27017/zoterosci-stats

# There is no Zotero API key variable here on purpose: the key is entered
# once in the app's Settings page and stored only in your local MongoDB
# (the `configs` collection) - never in this file, and never in git.
# Create a READ-ONLY key at https://www.zotero.org/settings/keys

# Access management (optional). Leave unset for local/internal use - the
# whole app stays open, exactly as if this feature didn't exist.
# Set to "true" to require login for every page and gate Settings to admins.
# NEXT_PUBLIC_AUTH_ENABLED=true

# Only used once, to create the first admin account on startup if no admin
# exists yet in the `users` collection. The plaintext password is never
# stored - it's hashed immediately and these variables can be removed
# afterwards. Additional members are created from the Settings page.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
