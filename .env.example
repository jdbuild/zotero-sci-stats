# Copy this file to .env.local and adjust the values.
# .env.local is git-ignored and must never be committed.

# Connection string for the local (or remote) MongoDB instance used as
# the read-only cache/sync store for your Zotero library.
# Default matches the docker-compose.yml service in this repo.
MONGODB_URI=mongodb://127.0.0.1:27017/zoterosci-stats

# There is no Zotero API key variable here on purpose: the key is entered
# once in the app's Settings page and stored only in your local MongoDB
# (the `configs` collection) - never in this file, and never in git.
# Create a READ-ONLY key at https://www.zotero.org/settings/keys
